PORT=5000

# MongoDB (Use Atlas URI or local)
MONGO_URI=mongodb://127.0.0.1:27017/mernauth

# JWT
JWT_SECRET=your_strong_jwt_secret_key_here_change_this
JWT_EXPIRES_IN=7d

# Client URLs
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email (Gmail App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password_here
